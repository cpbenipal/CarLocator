@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <!-- Home Page -->
    <section class="py-5 text-center">
        <div class="container">
            <h1>Welcome to VIN Search</h1>
            <p>Find your vehicle or register your business.</p>
            <a href="search.html" class="btn btn-primary">Search Your Vehicle</a>
            <a href="/Register" class="btn btn-success">Register Business</a>
        </div>
    </section>
    <!-- Search Section -->
    <section class="py-5">
        <div class="container">
            <h2 class="text-center mb-4">Search for Your Vehicle</h2>
            <form class="row g-3">
                <div class="col-md-8 offset-md-2">
                    <input type="text" class="form-control" placeholder="Enter VIN Number" required>
                </div>
                <div class="col-12 text-center">
                    <button type="submit" class="btn btn-primary">Search</button>
                </div>
            </form>
        </div>
    </section>
</div>
