@page
@model CLIMFinders.Web.Pages.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h2 class="text-center mb-4">Register</h2>
            <form method="post">
                <div class="row">
                    <!-- Left Column -->
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Facility</label>
                            <select asp-for="Input.FacilityId" asp-items="Model.Roles" required class="form-control">
                                <option value="">-- Select Facility Type --</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Email</label>
                            <input type="email" asp-for="Input.Email" class="form-control" required />
                        </div>
                        <div class="form-group">
                            <label>Name</label>
                            <input type="text" asp-for="Input.Name" class="form-control" required />
                        </div>
                        <div class="form-group">
                            <label>Contact Person</label>
                            <input type="text" asp-for="Input.ContactPerson" class="form-control" required />
                        </div>
                        <div class="form-group">
                            <label>Phone</label>
                            <input type="tel" asp-for="Input.Phone" class="form-control" required />
                        </div>
                    </div>

                    <!-- Right Column -->
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Address</label>
                            <input type="text" asp-for="Input.Address" class="form-control" required />
                        </div>
                        <div class="form-group">
                            <label>City</label>
                            <input type="text" asp-for="Input.City" class="form-control" required />
                        </div>
                        <div class="form-group">
                            <label>State</label>
                            <input type="text" asp-for="Input.State" class="form-control" required />
                        </div>
                        <div class="form-group">
                            <label>Zip Code</label>
                            <input type="text" asp-for="Input.ZipCode" class="form-control" required />
                        </div>
                     
                    </div>
                </div>
                <div class="form-group">
                    <label asp-for="Input.Description" class="form-label"></label>
                    <textarea asp-for="Input.Description" class="form-control" rows="3"></textarea>
                </div>
                <!-- Submit Button -->
                <div class="text-center">
                    <button type="submit" class="btn btn-primary btn-lg mt-3">Register</button>
                </div>
            </form>
        </div>
    </div>
</div>
