@page
@model SearchModel
@{
    ViewData["Title"] = "Vehicle Search";
}

<style>
    /* Style the "No records found" message */
    td.dataTables_empty {
        text-align: center;
        font-size: 14px;
        font-weight: bold;
        color: #ff0000; /* Red color */
        background-color: #f8f9fa; /* Light grey background */
        padding: 20px;
    }
</style>
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <h2 class="text-center my-4">Search for Your Vehicle</h2>
            <div class="card p-4 shadow">
                <form id="searchForm">
                    <div class="row">
                        <div class="col-md-10">
                            <input asp-for="Input.vinInput" class="form-control" placeholder="Enter VIN (e.g., 1HGCM82633A123456)" required />
                            <span asp-validation-for="Input.vinInput" class="text-danger"></span>
                        </div>
                        <div class="col-md-2">
                            <button id="searchButton" type="submit" class="btn btn-primary w-100">Search</button>
                        </div>
                    </div>
                </form>
            </div>

            <div class="mt-4 alert alert-danger" id="errorMessage" style="display: none;"></div>
            <div class="sssss">

                <h4>Search Results</h4>

                <table class="table-responsive w-100 table table-striped" id="vehiclesTable">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>VIN</th>
                            <th>Make</th>
                            <th>Model</th>
                            <th>Color</th>
                            <th>Year</th>
                            <th>Impound Lot</th>
                            <th>Facility</th>
                            <th>Date Impounded</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>

        </div>
    </div>
</div>
<script type="text/javascript" src="~/customJs/searchvehicle.js"></script>
